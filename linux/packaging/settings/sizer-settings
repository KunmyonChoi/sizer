# ── 경로(linux/Sources/Sizer/Paths.swift 와 같은 규칙) ─────────────────────────

def home_dir():
    return os.path.expanduser("~")


def config_home():
    value = os.environ.get("XDG_CONFIG_HOME", "")
    return value if value.startswith("/") else os.path.join(home_dir(), ".config")


def config_path():
    return os.path.join(config_home(), "sizer", "config.json")


def videos_dir(home, cfg_home):
    """user-dirs.dirs 의 XDG_VIDEOS_DIR(없거나 $HOME 이면 ~/Videos)."""
    try:
        with open(os.path.join(cfg_home, "user-dirs.dirs"), encoding="utf-8") as f:
            for line in f:
                line = line.strip()
                if line.startswith("XDG_VIDEOS_DIR="):
                    value = line.split("=", 1)[1].strip('"').replace("$HOME", home)
                    if value.startswith("/") and os.path.normpath(value) != os.path.normpath(home):
                        return value
    except OSError:
        pass
    return os.path.join(home, "Videos")


def default_folder(name, home, cfg_home):
    return os.path.join(videos_dir(home, cfg_home), "Sizer", name)


def expand(path, home):
    if path == "~":
        return home
    if path.startswith("~/"):
        return home + path[1:]
    if path.startswith("$HOME"):
        return home + path[len("$HOME"):]
    return path


def abbreviate(path, home):
    home = home.rstrip("/")
    if path == home:
        return "~"
    if path.startswith(home + "/"):
        return "~" + path[len(home):]
    return path


# ── 설정 문서(순수 함수 — test_sizer_settings.py) ─────────────────────────────

def load_document(path):
    """(문서, 오류). 파일이 없으면 빈 문서. JSON 이 깨졌으면 문서 None — 덮어쓰지 않도록."""
    try:
        with open(path, encoding="utf-8") as f:
            doc = json.load(f)
    except FileNotFoundError:
        return {}, None
    except ValueError as error:
        return None, f"설정 파일의 JSON 형식이 잘못됐습니다: {error}"
    except OSError as error:
        return None, f"설정 파일을 읽을 수 없습니다: {error}"
    if not isinstance(doc, dict):
        return None, "설정 파일의 최상위가 JSON 객체가 아닙니다"
    return doc, None


def get_value(doc, key):
    """문서 값. 없으면 기본값 — 감지 세부값은 민감도 프리셋값, 폴더는 None."""
    section, _, name = key.rpartition(".")
    container = doc.get(section) if section else doc
    if isinstance(container, dict) and name in container:
        return container[name]
    if section == "still" and name in PRESET_KEYS:
        preset = get_value(doc, "still.sensitivity")
        return PRESETS.get(preset, PRESETS["conservative"])[name]
    if section == "folders":
        return None
    return CONTROLS[key]["default"]


def apply_changes(doc, changes):
    """{키: 값 또는 DELETE} 를 적용한 새 문서."""
    doc = copy.deepcopy(doc)
    for key, value in changes.items():
        section, _, name = key.rpartition(".")
        if section:
            if not isinstance(doc.get(section), dict):
                doc[section] = {}
            container = doc[section]
        else:
            container = doc
        if value is DELETE:
            container.pop(name, None)
        else:
            container[name] = value
    return doc


def changes_for(key, value):
    """한 컨트롤 변경이 파일에 주는 변경. 민감도 프리셋을 고르면 감지 세부값을 지워 프리셋이 정하게 한다
    (macOS 의 applySensitivityPreset 과 같은 결과)."""
    changes = {key: value}
    if key == "still.sensitivity":
        for name in PRESET_KEYS:
            changes[f"still.{name}"] = DELETE
    return changes


def write_json_atomic(path, doc):
    directory = os.path.dirname(path)
    os.makedirs(directory, exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix=".config-", suffix=".json", dir=directory)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            json.dump(doc, f, ensure_ascii=False, indent=2)
            f.write("\n")
        os.replace(tmp, path)   # 데몬이 반쯤 쓰인 파일을 읽지 않게 이름 바꾸기로 교체
    except BaseException:
        if os.path.exists(tmp):
            os.unlink(tmp)
        raise


def save_changes(path, changes):
    """파일을 새로 읽어 바꾼 키만 고쳐 쓴다. 실패하면 오류 문자열."""
    doc, error = load_document(path)
    if error:
        return error
    try:
        write_json_atomic(path, apply_changes(doc, changes))
    except OSError as err:
        return f"설정을 저장하지 못했습니다: {err}"
    return None


def coerce(control, value):
    if control["type"] == "number" and control.get("digits", 0) == 0:
        return int(round(value))
    if control["type"] == "number":
        return round(float(value), control["digits"])
    return value


def number_bounds(control, value):
    """파일에 화면 범위 밖 값(직접 고친 값)이 있으면 조용히 바꾸지 않도록 범위를 넓힌다."""
    low, high = control["min"], control["max"]
    if isinstance(value, (int, float)) and not isinstance(value, bool):
        low, high = min(low, value), max(high, value)
    return low, high


def choices_with(control, value):
    """현재 값이 선택지에 없으면(직접 고친 값) 맨 끝에 추가해 보여 준다."""
    choices = [list(c) for c in control["choices"]]
    if value is not None and value not in [c[0] for c in choices]:
        choices.append([value, f"{value} (직접 설정)"])
    return choices


def text_is_valid(control, text):
    import re
    pattern = control.get("pattern")
    return pattern is None or re.match(pattern, text) is not None


def group_visible(tag, doc):
    mode = get_value(doc, "still.mode")
    return {
        "detect": mode != "off",
        "trim": mode == "trim",
        "fastForward": mode == "fastForward",
    }.get(tag, True)


def folder_conflict(doc, key, new_path, home, cfg_home):
    """출력 폴더가 드롭 폴더와 같으면 결과가 다시 변환된다(데몬도 거부한다)."""
    other = {"folders.drop": "folders.output", "folders.output": "folders.drop"}.get(key)
    if other is None:
        return None
    current = get_value(doc, other) or default_folder(other.split(".")[1], home, cfg_home)
    if os.path.normpath(expand(current, home)) == os.path.normpath(expand(new_path, home)):
        return "출력 폴더는 드롭 폴더와 달라야 합니다(결과가 다시 변환됩니다)"
    return None


def sizer_command():
    sibling = os.path.join(os.path.dirname(os.path.realpath(__file__)), "sizer")
    if os.access(sibling, os.X_OK):
        return sibling
    return shutil.which("sizer") or os.path.expanduser("~/.local/bin/sizer")


def run_detached(args):
    try:
        subprocess.Popen(args, start_new_session=True, stdin=subprocess.DEVNULL,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except OSError as error:
        print(f"sizer-settings: 실행 실패 {args[0]}: {error}", file=sys.stderr)


def command_output(args):
    try:
        return subprocess.run(args, capture_output=True, text=True, timeout=5).stdout.strip()
    except (OSError, subprocess.TimeoutExpired):
        return ""


# ── 창 ────────────────────────────────────────────────────────────────────────

def run_gui():
    try:
        import gi
        gi.require_version("Gtk", "4.0")
        gi.require_version("Adw", "1")
        from gi.repository import Adw, Gio, GLib, Gtk
    except (ImportError, ValueError) as error:
        message = "설정 창에는 gir1.2-gtk-4.0 과 gir1.2-adw-1 이 필요합니다"
        print(f"sizer-settings: {message} ({error})", file=sys.stderr)
        run_detached(["notify-send", "--app-name=Sizer", "Sizer", message])
        return 1
    if (Adw.get_major_version(), Adw.get_minor_version()) < (1, 4):
        print("sizer-settings: libadwaita 1.4 이상이 필요합니다", file=sys.stderr)
        return 1

    GLib.set_prgname(APP_ID)           # 창을 com.dilly.sizer.Settings.desktop(Sizer 아이콘)과 짝짓는다
    GLib.set_application_name("Sizer 설정")
    home, cfg_home, path = home_dir(), config_home(), config_path()

    class SettingsWindow(Adw.PreferencesWindow):
        def __init__(self, app):
            super().__init__(application=app, title="Sizer 설정")
            self.set_default_size(640, 760)
            self.set_search_enabled(False)
            self.rows = {}
            self.groups = {}
            self.pending = {}
            self.save_source = 0
            self.updating = False
            self.doc, error = load_document(path)
            for title, icon, groups in PAGES:
                page = Adw.PreferencesPage(title=title, icon_name=icon)
                for group_title, tag, keys in groups:
                    group = Adw.PreferencesGroup(title=group_title or "")
                    for key in keys:
                        row = self.build_row(key)
                        self.rows[key] = row
                        group.add(row)
                    if tag:
                        self.groups[tag] = group
                    page.add(group)
                if title == "일반":
                    page.add(self.build_about_group())
                self.add(page)
            if error:
                # 깨진 파일을 덮어쓰지 않는다 — 고칠 수 있게 파일 열기만 남긴다.
                self.doc = {}
                for row in self.rows.values():
                    row.set_sensitive(False)
                self.add_toast(Adw.Toast(title=error + " — 파일을 고친 뒤 다시 여세요", timeout=0))
            self.refresh_state()
            self.connect("close-request", self.on_close)

        # 행 만들기

        def build_row(self, key):
            control = CONTROLS[key]
            value = get_value(self.doc or {}, key)
            kind = control["type"]
            subtitle = control.get("subtitle") or ""
            if kind == "switch":
                row = Adw.SwitchRow(title=control["label"], subtitle=subtitle)
                row.set_active(bool(value))
                row.connect("notify::active", lambda r, _p: self.changed(key, r.get_active()))
            elif kind == "number":
                low, high = number_bounds(control, value)
                adjustment = Gtk.Adjustment(value=value, lower=low, upper=high,
                                            step_increment=control["step"], page_increment=control["step"] * 5)
                row = Adw.SpinRow(title=control["label"], subtitle=subtitle, adjustment=adjustment,
                                  digits=control["digits"])
                row.connect("notify::value", lambda r, _p: self.changed(key, coerce(control, r.get_value())))
            elif kind == "choice":
                choices = choices_with(control, value)
                row = Adw.ComboRow(title=control["label"], subtitle=subtitle,
                                   model=Gtk.StringList.new([label for _, label in choices]))
                row.set_selected([c[0] for c in choices].index(value) if value in [c[0] for c in choices] else 0)
                row.choices = choices
                row.connect("notify::selected", lambda r, _p: self.changed(key, r.choices[r.get_selected()][0]))
            elif kind == "text":
                row = Adw.EntryRow(title=f"{control['label']} ({control['hint']})" if control.get("hint") else control["label"])
                row.set_text(str(value))
                row.set_show_apply_button(True)
                row.connect("apply", lambda r: self.on_text_apply(key, r))
            else:   # folder
                row = Adw.ActionRow(title=control["label"])
                row.set_subtitle_lines(1)
                button = Gtk.Button(label="변경…", valign=Gtk.Align.CENTER)
                button.connect("clicked", lambda _b: self.choose_folder(key))
                row.add_suffix(button)
                row.set_subtitle(self.folder_display(key))
            return row

        def build_about_group(self):
            group = Adw.PreferencesGroup(title="정보")
            version = command_output([sizer_command(), "--version"]).replace("sizer ", "") or "—"
            group.add(Adw.ActionRow(title="버전", subtitle=version))
            self.service_row = Adw.ActionRow(title="서비스")
            group.add(self.service_row)
            files = Adw.ActionRow(title="파일")
            for label, target in (("설정 파일 열기", "config"), ("로그 열기", "logs")):
                button = Gtk.Button(label=label, valign=Gtk.Align.CENTER)
                button.connect("clicked", lambda _b, t=target: run_detached([sizer_command(), "open", t]))
                files.add_suffix(button)
            group.add(files)
            self.refresh_service()
            GLib.timeout_add_seconds(3, self.refresh_service)
            return group

        def folder_display(self, key):
            value = get_value(self.doc or {}, key)
            if value:
                return value
            return abbreviate(default_folder(key.split(".")[1], home, cfg_home), home) + " (기본값)"

        # 변경 · 저장

        def changed(self, key, value):
            if self.updating:
                return
            changes = changes_for(key, value)
            self.doc = apply_changes(self.doc, changes)
            self.pending.update(changes)
            if key == "still.sensitivity":
                self.set_rows_from_doc([f"still.{name}" for name in PRESET_KEYS])
            self.refresh_state()
            if self.save_source:
                GLib.source_remove(self.save_source)
            self.save_source = GLib.timeout_add(300, self.flush)   # 스핀 버튼을 누르고 있을 때 연달아 쓰지 않게

        def flush(self):
            self.save_source = 0
            if not self.pending:
                return False
            error = save_changes(path, self.pending)
            self.pending = {}
            if error:
                self.add_toast(Adw.Toast(title=error, timeout=6))
            return False

        def on_close(self, _window):
            if self.save_source:
                GLib.source_remove(self.save_source)
            self.flush()
            return False

        def on_text_apply(self, key, row):
            control = CONTROLS[key]
            text = row.get_text().strip()
            if not text_is_valid(control, text):
                row.add_css_class("error")
                self.add_toast(Adw.Toast(title=f"{control['label']}: 형식이 맞지 않습니다({control['hint']})", timeout=4))
                return
            row.remove_css_class("error")
            self.changed(key, text)

        def choose_folder(self, key):
            dialog = Gtk.FileDialog(title=CONTROLS[key]["label"], modal=True)
            current = expand(get_value(self.doc, key) or default_folder(key.split(".")[1], home, cfg_home), home)
            if os.path.isdir(current):
                dialog.set_initial_folder(Gio.File.new_for_path(current))

            def done(dlg, result):
                try:
                    folder = dlg.select_folder_finish(result)
                except GLib.Error:
                    return   # 취소
                chosen = folder.get_path() if folder else None
                if not chosen:
                    return
                conflict = folder_conflict(self.doc, key, chosen, home, cfg_home)
                if conflict:
                    self.add_toast(Adw.Toast(title=conflict, timeout=5))
                    return
                self.changed(key, abbreviate(chosen, home))
                self.rows[key].set_subtitle(self.folder_display(key))

            dialog.select_folder(self, None, done)

        # 화면 갱신

        def set_rows_from_doc(self, keys):
            self.updating = True
            try:
                for key in keys:
                    row, control, value = self.rows[key], CONTROLS[key], get_value(self.doc, key)
                    if control["type"] == "number":
                        low, high = number_bounds(control, value)
                        row.get_adjustment().set_lower(low)
                        row.get_adjustment().set_upper(high)
                        row.set_value(value)
            finally:
                self.updating = False

        def refresh_state(self):
            doc = self.doc or {}
            for tag, group in self.groups.items():
                if tag == "image":
                    group.set_sensitive(bool(get_value(doc, "image.enabled")))
                else:
                    group.set_visible(group_visible(tag, doc))
            self.rows["image.quality"].set_sensitive(get_value(doc, "image.format") != "png")
            self.rows["still.mode"].set_subtitle(MODE_HELP.get(get_value(doc, "still.mode"), ""))

        def refresh_service(self):
            state = command_output(["systemctl", "--user", "is-active", "sizer.service"])
            self.service_row.set_subtitle({"active": "실행 중 — 저장하면 바로 적용됩니다",
                                           "activating": "시작 중"}.get(state, "꺼짐 — 트레이 메뉴나 앱 목록에서 Sizer 를 실행하세요"))
            return True

    def on_activate(app):
        window = app.get_active_window() or SettingsWindow(app)
        window.present()

    app = Adw.Application(application_id=APP_ID)
    app.connect("activate", on_activate)
    return app.run([sys.argv[0]])


def main(argv):
    if "--dump-spec" in argv:
        print(json.dumps(spec_json(), ensure_ascii=False, indent=2))
        return 0
    if not os.path.exists(config_path()):
        # 첫 실행이면 sizer 가 기본 설정 파일(폴더 경로 포함)을 만들게 한다.
        command_output([sizer_command(), "config", "path"])
        command_output([sizer_command(), "status"])
    return run_gui()


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
